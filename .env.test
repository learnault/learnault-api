PORT=5000
NODE_ENV=test
STELLAR_NETWORK=testnet # testnet | mainnet   (default: testnet)
STELLAR_FUNDING_AMOUNT=10
STELLAR_FUNDING_MIN_BALANCE=1
STELLAR_FUNDING_MAX_RETRIES=5
JWT_SECRET=test-jwt-secret-for-integration-tests
DATABASE_URL=postgresql://user:password@localhost:5432/learnault_test
SMS_PROVIDER=mock
DELETION_COOLING_OFF_DAYS=7