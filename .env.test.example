# Test Environment Configuration
# Copy this file to .env.test and adjust values as needed

# Server
PORT=5000
NODE_ENV=test

# Database
DATABASE_URL=postgresql://testuser:testpass@localhost:5432/learnault_test

# JWT
JWT_SECRET=test-jwt-secret-change-in-production

# Stellar
STELLAR_NETWORK=testnet
STELLAR_FUNDING_AMOUNT=10
STELLAR_FUNDING_MIN_BALANCE=1
STELLAR_FUNDING_MAX_RETRIES=5

# SMS Provider (use mock for tests)
SMS_PROVIDER=mock

# Account Lifecycle
DELETION_COOLING_OFF_DAYS=7

# Rate Limiting (relaxed for testing)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_OTP_WINDOW_MS=900000
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_GENERAL_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=100
