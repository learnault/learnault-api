PORT=5000
NODE_ENV=development
STELLAR_NETWORK=testnet
JWT_SECRET=your_jwt_secret
# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/learnault_db?schema=public"

# Avatar Upload & Storage (leave S3_BUCKET empty to use dev FakeStorageProvider)
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AVATAR_MAX_SIZE_BYTES=5242880
INTENT_TTL_SECONDS=900

# ClamAV Malware Scanner (leave CLAMAV_HOST empty to use NoopScanner in dev)
CLAMAV_HOST=
CLAMAV_PORT=3310
